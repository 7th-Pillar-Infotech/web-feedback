# Runtime artifacts — never publish these.
# Installed dependencies (restored via `npm install` / ensure-running.sh).
server/node_modules/
server-cf/node_modules/

# Cloudflare Worker build output + local state (regenerated by `npm run build`).
server-cf/src/assets.gen.js
server-cf/.wrangler/
server-cf/package-lock.json

# The local feedback database and its WAL/SHM sidecars (contains real feedback).
server/feedback.db
server/feedback.db-shm
server/feedback.db-wal

# Saved screenshots of real pages under review (may be private/sensitive).
server/screenshots/

# Collector log.
server/collector.log

# OS / editor noise.
.DS_Store
